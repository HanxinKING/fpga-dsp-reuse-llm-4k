# RK FMC1 + FH1402 SSD1. VADJ assumption: 1.8 V.
# Native PCIe X1Y0 lane 0..3 uses GT Y11..Y8. FMC DP0..3 is Y8..Y11.
# Map top vectors to DP3..DP0: supported full x4 lane reversal, not a permutation.
create_clock -period 10.000 -name m2_refclk [get_ports m2_refclk_p]
set_property PACKAGE_PIN AF12 [get_ports {m2_refclk_p}]
set_property PACKAGE_PIN AF11 [get_ports {m2_refclk_n}]
set_property PACKAGE_PIN AY27 [get_ports {m2_perst_n}]
set_property PACKAGE_PIN AJ2 [get_ports {m2_pcie_rxp[0]}]
set_property PACKAGE_PIN AK4 [get_ports {m2_pcie_rxp[1]}]
set_property PACKAGE_PIN AL2 [get_ports {m2_pcie_rxp[2]}]
set_property PACKAGE_PIN AM4 [get_ports {m2_pcie_rxp[3]}]
set_property PACKAGE_PIN AJ1 [get_ports {m2_pcie_rxn[0]}]
set_property PACKAGE_PIN AK3 [get_ports {m2_pcie_rxn[1]}]
set_property PACKAGE_PIN AL1 [get_ports {m2_pcie_rxn[2]}]
set_property PACKAGE_PIN AM3 [get_ports {m2_pcie_rxn[3]}]
set_property PACKAGE_PIN AH8 [get_ports {m2_pcie_txp[0]}]
set_property PACKAGE_PIN AJ6 [get_ports {m2_pcie_txp[1]}]
set_property PACKAGE_PIN AK8 [get_ports {m2_pcie_txp[2]}]
set_property PACKAGE_PIN AL6 [get_ports {m2_pcie_txp[3]}]
set_property PACKAGE_PIN AH7 [get_ports {m2_pcie_txn[0]}]
set_property PACKAGE_PIN AJ5 [get_ports {m2_pcie_txn[1]}]
set_property PACKAGE_PIN AK7 [get_ports {m2_pcie_txn[2]}]
set_property PACKAGE_PIN AL5 [get_ports {m2_pcie_txn[3]}]
set_property IOSTANDARD LVCMOS18 [get_ports m2_perst_n]
